---
import stannumLogo from '../assets/stannum-logo.svg';
import LogoAgenciaG from './LogoAgenciaG.astro';
---

<footer class="border-t border-default pt-16 pb-10">
  <div class="container">
    <p class="eyebrow">ORGANIZAN</p>

    <div class="mt-8 flex flex-wrap items-start gap-x-12 gap-y-8">
      <div class="flex items-center gap-4">
        <img src={stannumLogo.src} alt="STANNUM" width="44" height="44" class="w-11 h-11" />
        <span class="text-primary font-black uppercase tracking-[0.12em] text-base">STANNUM</span>
      </div>

      <span class="text-secondary text-2xl self-center hidden md:inline">·</span>

      <div class="flex items-center gap-4">
        <LogoAgenciaG size={44} fill="#FFFFFF" />
        <div class="flex flex-col leading-tight">
          <span class="text-primary font-bold uppercase tracking-[0.08em]" style="font-size: 0.85rem;">
            Gabriel Páez Laurent
          </span>
          <span class="text-secondary mt-1" style="font-size: 0.75rem;">Agencia Digital</span>
        </div>
      </div>
    </div>

    <div class="divider mt-12"></div>

    <div class="mt-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <p class="body-sm">© 2026 Summit IA Tucumán · STANNUM · LAURENT</p>
      <p class="body-sm">17 de Junio 2026 · Hotel Hilton Tucumán</p>
    </div>
  </div>
</footer>
