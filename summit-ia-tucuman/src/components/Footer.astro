---
import stannumLogo from '../assets/stannum-logo.svg';
import laurentLogo from '../assets/laurent-logo.svg';
---

<footer class="border-t border-default pt-16 pb-10">
  <div class="container">
    <p class="eyebrow">ORGANIZAN</p>

    <div class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-6">
      <div class="flex items-center gap-3">
        <img src={stannumLogo.src} alt="STANNUM" width="40" height="40" class="w-10 h-10" />
        <span class="text-primary font-bold uppercase tracking-[0.12em] text-sm">STANNUM</span>
      </div>

      <span class="text-secondary text-2xl">·</span>

      <div class="flex items-center gap-3">
        <img src={laurentLogo.src} alt="LAURENT" width="40" height="40" class="w-10 h-10" />
        <span class="text-primary font-bold uppercase tracking-[0.12em] text-sm">LAURENT</span>
      </div>
    </div>

    <div class="divider mt-12"></div>

    <div class="mt-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <p class="body-sm">© 2026 Summit IA Tucumán · STANNUM · LAURENT</p>
      <p class="body-sm">17 de Junio 2026 · Hotel Hilton Tucumán</p>
    </div>
  </div>
</footer>
