---
const niveles = [
  {
    n: '01',
    name: 'Novato',
    range: '0–3 PTS',
    desc: 'La IA todavía no entró en tu trabajo. El Summit te da las primeras herramientas aplicadas.',
  },
  {
    n: '02',
    name: 'Copiloto',
    range: '4–7 PTS',
    desc: 'Ya probaste la IA pero no la potenciás. En el Summit cruzás esa barrera de una vez.',
  },
  {
    n: '03',
    name: 'Experto',
    range: '8–11 PTS',
    desc: 'La IA ya es parte de tu flujo. Operás en el 15% que se mueve primero.',
  },
  {
    n: '04',
    name: 'Líder IA',
    range: '12–15 PTS',
    desc: 'La IA es infraestructura de tu empresa. Tu presencia eleva el nivel del evento.',
  },
];
---

<section id="test" class="section section-alt reveal-section border-t border-default">
  <div class="container">
    <p class="eyebrow anim-in">EVALUÁ TU NIVEL</p>
    <h2 class="headline-lg mt-6 anim-in">
      ¿EN QUÉ NIVEL <span class="accent">OPERÁS?</span>
    </h2>
    <p class="body-lg mt-8 max-w-2xl anim-in">
      El 90% de los CEOs cree que usa bien la IA. Solo el 12% realmente la aprovecha como ventaja
      competitiva.
    </p>

    <div class="mt-16 md:mt-20 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        niveles.map((nv) => (
          <article class="card anim-in flex flex-col gap-5">
            <div class="flex items-baseline justify-between">
              <span class="card-num">{nv.n}</span>
              <span class="body-sm tracking-[0.15em] uppercase">{nv.range}</span>
            </div>
            <h3 class="headline-md">{nv.name}</h3>
            <p class="body-lg !text-base">{nv.desc}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-16 anim-in">
      <a
        href="https://testdedominioia.lovable.app"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary w-fit"
      >
        Hacer el test
      </a>
      <p class="body-sm mt-4">Gratuito · Sin compromiso · Resultado inmediato</p>
    </div>
  </div>
</section>
