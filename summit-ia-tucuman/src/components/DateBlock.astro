---
const blocks = [
  { id: 'cd-days', label: 'DÍAS' },
  { id: 'cd-hours', label: 'HORAS' },
  { id: 'cd-mins', label: 'MIN' },
  { id: 'cd-secs', label: 'SEG' },
];
---

<section class="section section-alt reveal-section">
  <div class="container">
    <p class="eyebrow anim-in">EL EVENTO</p>
    <h2 class="headline-lg mt-6 anim-in">17 DE <span class="accent">JUNIO</span></h2>
    <p class="body-lg mt-8 anim-in max-w-2xl">
      Miércoles 17 de Junio 2026 · 16:00 hs · acreditación 15:30<br />
      Hotel Hilton Tucumán · 100 cupos
    </p>

    <div class="mt-16 md:mt-20 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {
        blocks.map((b) => (
          <div class="countdown-box anim-in">
            <span id={b.id} class="countdown-num tabular-nums">00</span>
            <span class="countdown-label">{b.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../scripts/countdown.ts';
</script>
