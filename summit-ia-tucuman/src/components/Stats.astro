---
const stats = [
  { value: '1000', prefix: '+', label: 'ENTRENADOS' },
  { value: '4', prefix: '', label: 'DOMINIOS IA' },
  { value: '100', prefix: '', label: 'CUPOS EXCLUSIVOS' },
];
---

<section class="section reveal-section border-t border-default">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-y-14 md:gap-y-0">
      {
        stats.map((s, i) => (
          <div
            class={`flex flex-col items-center md:items-start gap-2 anim-in px-4 md:px-10 ${
              i > 0 ? 'md:border-l' : ''
            }`}
            style={i > 0 ? 'border-color: rgba(50,203,191,0.15);' : ''}
          >
            <span class="stat-monumental" data-counter data-target={s.value} data-prefix={s.prefix}>
              {s.prefix}{Number(s.value).toLocaleString('es-AR')}
            </span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>
