---
const stats = [
  { value: '1000', prefix: '+', label: 'ENTRENADOS' },
  { value: '4', prefix: '', label: 'DOMINIOS IA' },
  { value: '100', prefix: '', label: 'CUPOS EXCLUSIVOS' },
];
---

<section class="section border-t border-default" data-reveal>
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-y-12 md:gap-y-0">
      {
        stats.map((s, i) => (
          <div
            class={`flex flex-col items-center md:items-start gap-3 anim-in px-4 md:px-8 ${
              i > 0 ? 'md:border-l' : ''
            }`}
            style={i > 0 ? 'border-color: var(--color-border-default);' : ''}
          >
            <span class="stat-number" data-counter data-target={s.value} data-prefix={s.prefix}>
              {s.prefix}{Number(s.value).toLocaleString('es-AR')}
            </span>
            <span class="eyebrow text-secondary" style="color: var(--color-text-secondary);">
              {s.label}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
