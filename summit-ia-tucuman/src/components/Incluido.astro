---
const items = [
  {
    n: '01',
    head: 'Banco de Prompts Premium',
    body: 'Prompts probados para ventas, operaciones y liderazgo.',
  },
  {
    n: '02',
    head: 'GPTs para tu Industria',
    body: 'Asistentes IA preconfigurados para casos de uso reales.',
  },
  {
    n: '03',
    head: 'Plataforma de Entrenamiento',
    body: 'Acceso continuo para seguir entrenando después del Summit.',
  },
  {
    n: '04',
    head: 'Diagnóstico IA Personalizado',
    body: 'Tu nivel, tus brechas y los próximos pasos para tu empresa.',
  },
];
---

<section class="section reveal-section border-t border-default">
  <div class="container">
    <p class="eyebrow anim-in">QUÉ INCLUYE</p>
    <h2 class="headline-lg mt-6 anim-in">
      HERRAMIENTAS PARA <span class="accent">USAR</span><br />
      DESDE EL DÍA SIGUIENTE
    </h2>

    <div class="mt-16 md:mt-20 grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        items.map((it) => (
          <article class="card anim-in flex flex-col gap-4">
            <span class="card-num">{it.n}</span>
            <h3 class="headline-md">{it.head}</h3>
            <p class="body-lg">{it.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
