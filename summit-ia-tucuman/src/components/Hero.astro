---

---

<section
  id="top"
  data-hero
  class="relative overflow-hidden pt-[140px] pb-24 md:pt-[180px] md:pb-32"
  style="background: radial-gradient(ellipse 60% 40% at 50% 0%, rgba(50,203,191,0.06) 0%, transparent 70%);"
>
  <div class="container relative">
    <p class="eyebrow" data-hero-eyebrow style="opacity:0; transform:translateY(20px);">
      Workshop exclusivo · Tucumán · 17 de Junio 2026
    </p>

    <h1 class="mt-10">
      <span
        class="headline-xl block"
        data-hero-word="0"
        style="opacity:0; transform:translateY(30px);"
      >
        IA SUMMIT
      </span>
      <span
        class="headline-xl block mt-2 md:mt-3"
        data-hero-word="1"
        style="opacity:0; transform:translateY(30px);"
      >
        TUCUMÁN
      </span>
      <span
        class="headline-xl block mt-2 md:mt-3 accent"
        data-hero-word="2"
        style="opacity:0; transform:translateX(-20px);"
      >
        2026
      </span>
    </h1>

    <p
      class="body-lg mt-10 md:mt-12 max-w-2xl"
      data-hero-sub
      style="opacity:0; transform:translateY(20px);"
    >
      Workshop exclusivo de Inteligencia Artificial aplicada a negocios.
    </p>

    <div
      class="mt-12 md:mt-14 flex flex-col gap-4"
      data-hero-cta
      style="opacity:0; transform:translateY(20px);"
    >
      <a href="#cta-final" class="btn-primary btn-primary-lg w-fit">Reservar mi lugar</a>
      <p class="body-sm">Solo 100 cupos · Selección requerida</p>
    </div>
  </div>
</section>
