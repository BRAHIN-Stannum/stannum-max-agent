---
import Watermark from './Watermark.astro';
---

<section
  id="cta-final"
  class="section relative overflow-hidden border-t border-default"
  data-reveal
>
  <div class="hero-radial" style="background: radial-gradient(circle at center, rgba(0,229,212,0.08) 0%, transparent 60%);"></div>
  <Watermark size={620} opacity={0.05} position="center" />
  <div class="grain"></div>

  <div class="container-stannum relative">
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center gap-10 md:gap-12">
      <p class="eyebrow anim-in">
        EVENTO EXCLUSIVO · SOLO 100 LUGARES · SELECCIÓN REQUERIDA
      </p>

      <h2 class="display-xl anim-in">
        Tu empresa en el NOA<br />merece la ventaja<br />de la IA.
      </h2>

      <div class="laser-line max-w-[120px] anim-in"></div>

      <p class="body-lg text-lg md:text-xl max-w-2xl anim-in">
        21 de Mayo · Hotel Hilton Tucumán · 16:00 hs.<br />
        Cupos limitados. El acceso se cierra cuando se completan.
      </p>

      <a href="#" class="btn-primary anim-in mt-4">Reservar mi lugar</a>

      <p class="caption anim-in">
        Cupos limitados por capacidad del Hilton · Selección requerida
      </p>
    </div>
  </div>
</section>
