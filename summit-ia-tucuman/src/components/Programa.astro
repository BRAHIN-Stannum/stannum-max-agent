---
const dominios = [
  {
    n: '01',
    name: 'Prompts Avanzados',
    dur: '30 MIN',
    desc: 'Construir instrucciones precisas que generan resultados profesionales. Fórmula RACS y exploración de roles.',
  },
  {
    n: '02',
    name: 'Personalización',
    dur: '30 MIN',
    desc: 'Configurar ChatGPT para que conozca tu empresa, rol y estilo. Memoria e instrucciones personalizadas.',
  },
  {
    n: '03',
    name: 'Funciones Avanzadas',
    dur: '30 MIN',
    desc: 'Dominar las herramientas que potencian resultados en trabajo real: búsqueda web, investigación, Canvas.',
  },
  {
    n: '04',
    name: 'Asistentes Personalizados',
    dur: '20 MIN',
    desc: 'Crear asistentes IA personalizados para tu empresa. Arquitectura de un GPT profesional + demo.',
  },
];
---

<section id="programa" class="section section-alt border-t border-default" data-reveal>
  <div class="container">
    <p class="eyebrow anim-in">EL PROGRAMA</p>
    <h2 class="headline-lg mt-6 anim-in">
      4 DOMINIOS DE <span class="accent">IA</span>
    </h2>
    <p class="body-lg mt-8 max-w-2xl anim-in">
      Cuatro bloques de entrenamiento directo. Sin teoría vacía — aplicación real en tu empresa
      desde el primer día.
    </p>

    <div class="mt-16 md:mt-20 grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        dominios.map((d) => (
          <article class="card anim-in flex flex-col gap-5">
            <div class="flex items-baseline justify-between">
              <span class="card-num">{d.n}</span>
              <span class="body-sm tracking-[0.15em] uppercase">{d.dur}</span>
            </div>
            <h3 class="headline-md">{d.name}</h3>
            <p class="body-lg">{d.desc}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
