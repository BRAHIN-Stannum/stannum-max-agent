---
import stannumLogo from '../assets/stannum-logo.svg';

const links = [
  { href: '#speaker', label: 'Speaker' },
  { href: '#programa', label: 'Programa' },
  { href: '#test', label: 'Test IA' },
];
---

<header
  id="site-nav"
  data-hidden="false"
  class="fixed inset-x-0 top-0 z-50 h-[72px] border-b border-default backdrop-blur-md transition-transform duration-300"
  style="background: rgba(5,5,5,0.85); transition: transform 320ms cubic-bezier(0.16,1,0.3,1); border-bottom-color: rgba(0,229,212,0.18); box-shadow: 0 1px 0 rgba(0,229,212,0.25), 0 8px 32px rgba(0,0,0,0.4);"
>
  <div class="container-stannum h-full flex items-center justify-between gap-8">
    <a href="#top" class="flex items-center gap-3 group">
      <img src={stannumLogo.src} alt="STANNUM" width="40" height="40" class="w-10 h-10" />
      <div class="flex flex-col leading-none">
        <span class="text-primary text-sm font-bold tracking-[0.18em] uppercase" style="font-family: var(--font-techno);">SUMMIT IA</span>
        <span class="text-accent text-[10px] tracking-[0.28em] uppercase mt-1" style="font-family: var(--font-techno); text-shadow: var(--text-glow);">TUCUMÁN 2026</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-body text-sm tracking-[0.18em] uppercase hover:text-accent transition-colors duration-300"
            style="font-family: var(--font-techno);"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a href="#reservar" class="btn-primary !h-11 !px-6 text-[11px]">Reservar mi lugar</a>
  </div>
</header>

<style>
  #site-nav[data-hidden='true'] {
    transform: translateY(-100%);
  }
</style>

<script>
  import '../scripts/nav.ts';
</script>
