---
const links = [
  { href: '#speaker', label: 'Speaker' },
  { href: '#programa', label: 'Programa' },
  { href: '#test', label: 'Test IA' },
];
---

<header
  id="site-nav"
  data-hidden="false"
  class="fixed inset-x-0 top-0 z-50 h-[72px] border-b border-default backdrop-blur-md transition-transform duration-300"
  style="background: rgba(5,5,7,0.8); transition: transform 320ms cubic-bezier(0.16,1,0.3,1);"
>
  <div class="container-stannum h-full flex items-center justify-between gap-8">
    <a href="#top" class="flex items-center gap-3 group">
      <svg viewBox="0 0 32 32" class="w-8 h-8" aria-hidden="true">
        <circle cx="16" cy="16" r="12" fill="none" stroke="#00E5D4" stroke-width="1"></circle>
        <polygon points="16,6 26,22 6,22" fill="none" stroke="#F5F5F7" stroke-width="1"></polygon>
      </svg>
      <div class="flex flex-col leading-none">
        <span class="text-primary text-sm font-medium tracking-[0.04em]">SUMMIT IA</span>
        <span class="eyebrow mt-1 text-[10px]">TUCUMÁN 2026</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-body text-sm tracking-[0.04em] hover:text-primary transition-colors duration-300"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a href="#reservar" class="btn-primary !h-11 !px-6 text-xs">Reservar mi lugar</a>
  </div>
</header>

<style>
  #site-nav[data-hidden='true'] {
    transform: translateY(-100%);
  }
</style>

<script>
  import '../scripts/nav.ts';
</script>
