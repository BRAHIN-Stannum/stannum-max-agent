---
import stannumLogo from '../assets/stannum-logo.svg';

const links = [
  { href: '#speaker', label: 'Speaker' },
  { href: '#programa', label: 'Programa' },
  { href: '#test', label: 'Test IA' },
];
---

<header
  id="site-nav"
  data-hidden="false"
  class="fixed inset-x-0 top-0 z-50 h-[72px] backdrop-blur-md"
  style="background: rgba(10,10,12,0.85); border-bottom: 1px solid var(--color-border-default); transition: transform 320ms cubic-bezier(0.16,1,0.3,1);"
>
  <div class="container h-full flex items-center justify-between gap-8">
    <a href="#top" class="flex items-center gap-3">
      <img src={stannumLogo.src} alt="STANNUM" width="28" height="28" class="w-7 h-7" />
      <span class="text-primary font-bold uppercase tracking-[0.12em] text-sm">STANNUM</span>
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-secondary text-[13px] tracking-[0.1em] uppercase hover:text-primary transition-colors duration-300"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a href="#cta-final" class="btn-primary !py-2 !px-5 text-[11px]">Reservar mi lugar</a>
  </div>
</header>

<style>
  #site-nav[data-hidden='true'] {
    transform: translateY(-100%);
  }
</style>

<script>
  import '../scripts/nav.ts';
</script>
