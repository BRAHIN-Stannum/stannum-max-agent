---
interface Props {
  size?: number;
  opacity?: number;
  position?: 'br' | 'bl' | 'tr' | 'tl' | 'center';
  color?: string;
  class?: string;
}

const {
  size = 420,
  opacity = 0.05,
  position = 'br',
  color = '#F5F5F7',
  class: className = '',
} = Astro.props;

const positions: Record<string, string> = {
  br: 'right: -80px; bottom: -80px;',
  bl: 'left: -80px; bottom: -80px;',
  tr: 'right: -80px; top: -80px;',
  tl: 'left: -80px; top: -80px;',
  center: 'left: 50%; top: 50%; transform: translate(-50%, -50%);',
};
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 400 400"
  fill="none"
  stroke={color}
  stroke-width="0.75"
  aria-hidden="true"
  class={`watermark ${className}`}
  style={`width:${size}px; height:${size}px; opacity:${opacity}; ${positions[position]}`}
>
  <circle cx="200" cy="200" r="180"></circle>
  <circle cx="200" cy="200" r="140"></circle>
  <circle cx="200" cy="200" r="100"></circle>
  <polygon points="200,40 340,280 60,280"></polygon>
  <polygon points="200,360 60,120 340,120"></polygon>
  <circle cx="200" cy="200" r="60"></circle>
  <line x1="200" y1="20" x2="200" y2="380" stroke-dasharray="2 6"></line>
  <line x1="20" y1="200" x2="380" y2="200" stroke-dasharray="2 6"></line>
</svg>
