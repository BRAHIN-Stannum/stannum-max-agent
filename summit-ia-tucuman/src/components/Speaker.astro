---
const credenciales = [
  { n: '01', text: 'Director Estratégico STANNUM' },
  { n: '02', text: '+1.000 líderes entrenados en LATAM' },
  { n: '03', text: '+100 empresas transformadas' },
  { n: '04', text: 'RGO ahorra +USD 3.000/mes con IA aplicada' },
  { n: '05', text: 'TechMBA ADEN Business School & George Washington University (EE.UU.)' },
];
---

<section id="speaker" class="section reveal-section border-t border-default">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-20">
      <div class="md:col-span-5">
        <p class="eyebrow anim-in">EL SPEAKER</p>
        <h2 class="headline-lg mt-6 anim-in">
          MARTÍN<br /><span class="accent">MERLINI</span>
        </h2>
        <p class="body-sm mt-6 anim-in">Director Estratégico STANNUM</p>
        <p class="body-lg mt-10 anim-in max-w-md">
          Especialista en Marketing Avanzado y Comercialización con más de una década de experiencia
          entrenando líderes y equipos de alto rendimiento.
        </p>
      </div>

      <ul class="md:col-span-7 flex flex-col">
        {
          credenciales.map((c) => (
            <li class="anim-in border-t border-default py-7 first:border-t-0 first:pt-0 grid grid-cols-[48px_1fr] gap-6 items-baseline">
              <span class="card-num">{c.n}</span>
              <span class="headline-md !text-[clamp(1rem,1.6vw,1.25rem)] !font-medium leading-relaxed">
                {c.text}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
