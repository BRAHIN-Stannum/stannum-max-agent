---
const items = [
  { time: '15:30', title: 'Acreditación y networking previo', desc: '15:30 – 16:00' },
  { time: '16:00', title: 'Apertura institucional', desc: '16:00 – 16:15 · Apertura del Summit' },
  { time: '16:15', title: 'Bloque 1: IA aplicada a negocios', desc: '16:15 – 17:30 · Demos en vivo' },
  { time: '17:30', title: 'Break y activación de sponsors', desc: '17:30 – 17:50' },
  { time: '17:50', title: 'Bloque 2: Casos de uso y transformación', desc: '17:50 – 19:00 · Herramientas y transformación organizacional' },
  { time: '19:00', title: 'Cierre, propuestas y networking final', desc: '19:00 – 19:20' },
];
---

<section class="section border-t border-default" data-reveal>
  <div class="container">
    <p class="eyebrow anim-in">PROGRAMA DEL DÍA</p>
    <h2 class="headline-lg mt-6 anim-in">
      AGENDA DEL <span class="accent">EVENTO</span>
    </h2>
    <p class="body-lg mt-8 max-w-2xl anim-in">
      4 horas de entrenamiento activo. Formación práctica, demos en vivo y networking de alto
      nivel.
    </p>

    <div class="mt-16 md:mt-20 flex flex-col">
      {
        items.map((it) => (
          <div class="anim-in grid grid-cols-[80px_1fr] md:grid-cols-[140px_1fr] gap-6 md:gap-12 py-7 md:py-8 border-t border-default last:border-b">
            <span class="card-num !text-[clamp(1.25rem,2vw,1.75rem)] !leading-tight pt-1">{it.time}</span>
            <div class="flex flex-col gap-2">
              <h3 class="headline-md !text-[clamp(1rem,1.8vw,1.375rem)] !font-semibold">{it.title}</h3>
              <p class="body-sm">{it.desc}</p>
            </div>
          </div>
        ))
      }
    </div>

    <p class="body-sm mt-10 anim-in">
      Pantalla LED, sonido profesional e internet dedicado. Break incluido.
    </p>
  </div>
</section>
