---
const blocks = [
  { id: 'cd-days', label: 'DÍAS' },
  { id: 'cd-hours', label: 'HORAS' },
  { id: 'cd-mins', label: 'MIN' },
  { id: 'cd-secs', label: 'SEG' },
];
---

<section class="section relative" data-reveal>
  <div class="container-stannum">
    <p class="eyebrow text-center anim-in">TIEMPO RESTANTE PARA EL EVENTO</p>

    <div class="mt-16 md:mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {
        blocks.map((b) => (
          <div class="anim-in card corner-marks flex flex-col items-center gap-4 py-10 md:py-12">
            <span
              id={b.id}
              class="number-mega !text-[clamp(64px,11vw,160px)] !leading-none tabular-nums"
            >
              00
            </span>
            <span class="eyebrow-muted">{b.label}</span>
          </div>
        ))
      }
    </div>

    <p class="caption mt-12 text-center text-muted anim-in">17 JUN 2026 · 16:00 ART</p>
  </div>
</section>

<script>
  import '../scripts/countdown.ts';
</script>
