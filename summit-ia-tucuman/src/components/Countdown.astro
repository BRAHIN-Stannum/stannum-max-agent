---
const blocks = [
  { id: 'cd-days', label: 'DÍAS' },
  { id: 'cd-hours', label: 'HORAS' },
  { id: 'cd-mins', label: 'MIN' },
  { id: 'cd-secs', label: 'SEG' },
];
---

<section class="section border-t border-default" data-reveal>
  <div class="container-stannum">
    <p class="eyebrow text-center anim-in">TIEMPO RESTANTE PARA EL EVENTO</p>

    <div class="mt-16 md:mt-20 grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-0">
      {
        blocks.map((b, i) => (
          <div class="flex flex-col items-center gap-4 md:gap-6 anim-in relative">
            <span
              id={b.id}
              class="number-mega !text-[clamp(72px,12vw,200px)] !leading-none tabular-nums"
            >
              00
            </span>
            <span class="eyebrow">{b.label}</span>
            {i < blocks.length - 1 && (
              <span
                class="hidden md:block absolute right-0 top-1/2 -translate-y-1/2 text-muted text-4xl"
                aria-hidden="true"
              >
                ·
              </span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import '../scripts/countdown.ts';
</script>
