import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import DateBlock from '../components/DateBlock.astro';
import Speaker from '../components/Speaker.astro';
import Programa from '../components/Programa.astro';
import Agenda from '../components/Agenda.astro';
import Incluido from '../components/Incluido.astro';
import TestIA from '../components/TestIA.astro';
